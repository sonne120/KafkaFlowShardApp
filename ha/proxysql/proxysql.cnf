# ============================================================================
# ProxySQL initial configuration (applied on first start, when
# /var/lib/proxysql/proxysql.db does not exist yet).
#
# Routing model for PacketShard:
#   hostgroup 0 = writer  (the ONLY hostgroup the app uses)
#   hostgroup 1 = reader  (parking lot for read-only nodes; no query
#                          rules route anything here — deliberate, because
#                          srv_pub's FOR UPDATE SKIP LOCKED and the outbox
#                          stored procedure must always hit the primary)
#
# Writer election is automatic: ProxySQL polls @@global.super_read_only
# on every server (check_type below). Orchestrator promotes a node by
# clearing super_read_only -> ProxySQL moves it into hostgroup 0.
# A revived ex-master boots read-only (see replication.cnf) -> it lands
# in hostgroup 1 and receives no traffic.
# ============================================================================

datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    interfaces="0.0.0.0:6033"
    default_query_delay=0
    default_query_timeout=36000000
    poll_timeout=2000
    server_version="8.4.0"
    threads=4
    max_connections=2048

    monitor_username="monitor"
    monitor_password="monitorpass"
    monitor_connect_interval=2000
    monitor_ping_interval=2000
    monitor_read_only_interval=1500
    monitor_read_only_timeout=1000
}

mysql_replication_hostgroups=
(
    {
        writer_hostgroup=0
        reader_hostgroup=1
        check_type="super_read_only"
        comment="packetshard outbox cluster"
    }
)

mysql_servers=
(
    { address="mysql-master", port=3306, hostgroup=0, max_connections=200 },
    { address="mysql-slave",  port=3306, hostgroup=1, max_connections=200 }
)

mysql_users=
(
    {
        username="app"
        password="apppass"
        default_hostgroup=0
        # Required, not optional. ProxySQL multiplexes frontend connections onto
        # backend ones, and without a default_schema the backend session lands in
        # information_schema regardless of the Database= in the app's connection
        # string. The relay sends `CALL GetDataFromTempTable(...)` unqualified
        # (MySqlConnector relies on the session schema), so it resolves in the
        # wrong database and fails with a misleading
        #   Access denied for user 'app'@'%' to database 'outboxdb'
        default_schema="outboxdb"
        transaction_persistent=1   # keep FOR UPDATE SKIP LOCKED txns pinned
        active=1
    }
)

mysql_query_rules=
(
    # Routing is uniform (everything goes to the writer), but multiplexing is
    # not safe for the relay's reservation call. ProxySQL hands each statement
    # to whichever backend connection is free, and `CALL GetDataFromTempTable`
    # is sent unqualified — it resolves against the backend session's current
    # schema. On a connection that has drifted off outboxdb it fails with a
    # misleading "Access denied for user 'app'@'%' to database 'outboxdb'",
    # intermittently, only for the relay and never for the ingest INSERTs.
    # multiplex=0 pins the connection for these calls.
    {
        rule_id=1
        active=1
        match_digest="^CALL"
        destination_hostgroup=0
        multiplex=0
        apply=1
    }
)
