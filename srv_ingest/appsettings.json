{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GrpcPort": "8080",
  "HealthPort": "8081",
  "KafkaServer": "kafka:9093",
  "SqlConnStr": "server=mysql;port=3306;database=outbox;user=root;password=root",
  "Topic": "SnapshotTopic",
  "Discovery": {
    "Provider": "Static",
    "Consul": { "Address": "http://consul:8500" },
    "Service": {
      "Name": "srv-ingest",
      "Port": "8080",
      "HealthPort": "8081",
      "HealthPath": "/health",
      "Tags": [ "grpc", "ingest" ]
    }
  }
}
