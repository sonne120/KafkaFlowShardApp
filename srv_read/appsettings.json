{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaServer": "kafka:9093",
  "ConsumerGroup": "ReadModelGroup",
  "CdcTopicPattern": "^pcap\\..*packets$",
  "Postgres": {
    "ConnStr": "Host=postgres;Port=5432;Database=readmodel;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnStr": "redis:6379",
    "TtlDays": "7"
  },
  "Consul": {
    "Enabled": "false",
    "Address": "http://consul:8500",
    "Service": {
      "Name": "srv-read",
      "Port": "8080",
      "HealthPath": "/health",
      "Tags": [ "rest", "read-model" ]
    }
  }
}
